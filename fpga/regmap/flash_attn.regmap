# flash_attn kernel AXI-Lite register map — single source of truth.
# Consumed by the Zig MMIO driver (device/pl, the flash tenant) and the RTL via the
# generated Verilog header (fpga/regmap/flash_attn.zig emits flash_regs.vh). Do not
# hand-edit the generated header or duplicate these constants; change them here.
#
# Mirrors the matmul regmap shape (ID/VERSION/CTRL/STATUS/CYCLES/CLK_HZ + a counter
# bank), but the config is flash's (head dims, head/kv/token counts, softmax scale)
# and the counters are the Q/K/V/O streams, not matmul's W/A/R.
#
# Format: offset  name  access  reset  description... (one register per line)
#
# offset  name          access  reset        description
0x00      ID            ro      0xF1A54A00   flash kernel identifier
0x04      VERSION       ro      0x00000003   v3 = v2 kv-major datapath + 32 query-head capacity
0x08      CTRL          wo      0x00000000   bit0 = start strobe (pulse)
0x0C      STATUS        ro      0x00000000   bit0 = busy, bit1 = done_latched
0x10      HEAD_DIM_Q    rw      0x00000000   head dim of Q/K (multiple of LANES)
0x14      HEAD_DIM_V    rw      0x00000000   head dim of V/O (multiple of LANES)
0x18      N_HEADS       rw      0x00000000   query heads
0x1C      N_HEAD_KV     rw      0x00000000   kv heads (GQA: head_ratio query heads share one)
0x20      HEAD_RATIO    rw      0x00000000   n_heads / n_head_kv (device-computed; no divider in RTL)
0x24      N_KV          rw      0x00000000   kv length (real masked extent; padded extent clamped by host)
0x28      N_TOKENS      rw      0x00000000   query tokens
0x2C      SCALE         rw      0x00000000   softmax scale (fp32 bits)
0x30      CYCLES        ro      0x00000000   busy-cycle count of last run
0x34      CLK_HZ        ro      0x00000000   fabric clock (Hz); set by bitstream build
0x38      LANES         ro      0x00000008   MAC lanes per dot beat (constant)
#
# Counter bank (latched per run, counts only while busy). Beats: AXIS transfers
# moved on each stream. Stalls: cycles the kernel was ready for a beat but the
# stream had none (input starved), or had an output beat the sink was not ready for.
0x3C      Q_BEATS       ro      0x00000000   Q AXIS beats moved last run
0x40      K_BEATS       ro      0x00000000   K AXIS beats moved last run
0x44      K_STALL       ro      0x00000000   cycles busy but K stream starved
0x48      V_BEATS       ro      0x00000000   V AXIS beats moved last run
0x4C      V_STALL       ro      0x00000000   cycles busy but V stream starved
0x50      O_BEATS       ro      0x00000000   O AXIS beats moved last run
0x54      O_STALL       ro      0x00000000   cycles busy but O sink backpressured
