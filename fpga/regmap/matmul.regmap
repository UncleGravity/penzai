# matmul kernel AXI-Lite register map — single source of truth.
# Consumed by the Zig MMIO driver (device/pl, P4) and the RTL via the generated
# Verilog header (generated at fpga/regmap/matmul_regs.vh). Do not hand-edit the
# generated header or duplicate these constants; change them here.
#
# Format: offset  name  access  reset  description... (one register per line)
#
# offset  name            access  reset        description
0x00      ID              ro      0xB05A2000   kernel identifier
0x04      VERSION         ro      0x0000000C   v12 = logical output rows and partial final TKEEP
0x08      CTRL            wo      0x00000000   bit0 = start strobe (pulse)
0x0C      STATUS          ro      0x00000000   bit0 = busy, bit1 = done_latched
0x10      NUM_Q1_BLOCKS   rw      0x00000000   K / 128
0x14      NUM_ROWBLOCKS   rw      0x00000000   ceil(M / ROWS)
0x18      CYCLES          ro      0x00000000   busy-cycle count of last run
0x1C      ROWS            ro      0x00000010   lanes per rowblock (constant)
#
# Counter bank (latched per run). Stall counters count cycles the kernel is busy
# but a stream cannot make progress; utilization = (CYCLES - max stall) / CYCLES.
# Beat counters count AXIS beats moved, for achieved bytes/cycle per stream.
0x20      W_STALL         ro      0x00000000   cycles busy but weight stream starved
0x24      A_STALL         ro      0x00000000   cycles busy but act stream starved
0x28      R_STALL         ro      0x00000000   cycles busy but result stream backpressured
0x2C      W_BEATS         ro      0x00000000   weight AXIS beats moved last run
0x30      A_BEATS         ro      0x00000000   act AXIS beats moved last run
0x34      R_BEATS         ro      0x00000000   result AXIS beats moved last run
#
# Multi-column kernel (v6+): columns multiplied per run (1 for decode, >1 prefill).
0x38      NUM_COLS        rw      0x00000000   activation columns per matmul
#
# Fabric clock of the bitstream, in Hz. The host reads this to convert cycle
# counters to time. The mc top exposes this register from a Verilog parameter
# populated by the Vivado build from the propagated clk_wiz output frequency.
# A zero value means the bitstream did not self-describe its clock.
0x3C      CLK_HZ          ro      0x00000000   fabric clock (Hz); set by bitstream build
0x40      WEIGHT_PORTS    ro      0x00000004   synchronized AXIS weight ports
0x44      WEIGHT_FMT      rw      0x00000001   1 = binary w1a8, 2 = ternary w158a8
0x48      NUM_ROWS        rw      0x00000000   logical output rows; 0 preserves full rowblocks
#
# (v8 had a writable EMIN window-floor register at 0x44. v9 bakes the window floor in as a
# constant of the f16 format — decode_top.EMIN_FLOOR — so there is no EMIN register and no
# per-model calibration; the 104-bit accumulator covers the full f16 range.)
