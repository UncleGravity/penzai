# matmul kernel AXI-Lite register map — single source of truth.
# Consumed by the Zig MMIO driver (device/pl, P4) and the RTL via the generated
# Verilog header (generated at fpga/regmap/matmul_regs.vh). Do not hand-edit the
# generated header or duplicate these constants; change them here.
#
# Format: offset  name  access  reset  description... (one register per line)
# Every unlisted bit of a read-only register, including every reserved high bit,
# reads zero.
#
# offset  name            access  reset        description
0x00      ID              ro      0xB05A2000   kernel identifier
0x04      VERSION         ro      0x00000011   v17 = PL weighted RMSNorm and exact residual-add with resident-R section chaining
0x08      CTRL            wo      0x00000000   bit0 = start strobe (pulse)
0x0C      STATUS          ro      0x00000000   bit0 = busy, bit1 = done_latched
0x10      NUM_Q1_BLOCKS   rw      0x00000000   K / 128
0x14      NUM_ROWBLOCKS   rw      0x00000000   ceil(M / ROWS)
0x18      CYCLES          ro      0x00000000   busy-cycle count of last run
0x1C      ROWS            ro      0x00000010   lanes per rowblock (constant)
#
# Counter bank (latched per run). Stall counters count cycles the kernel is busy
# but a stream cannot make progress; utilization = (CYCLES - max stall) / CYCLES.
# Beat counters count AXIS beats moved, for achieved bytes/cycle per stream.
0x20      W_STALL         ro      0x00000000   cycles busy but weight stream starved
0x24      A_STALL         ro      0x00000000   cycles busy but act stream starved
0x28      R_STALL         ro      0x00000000   cycles busy but result stream backpressured
0x2C      W_BEATS         ro      0x00000000   weight AXIS beats moved last run
0x30      A_BEATS         ro      0x00000000   act AXIS beats moved last run
0x34      R_BEATS         ro      0x00000000   result AXIS beats moved last run
#
# Multi-column kernel (v6+): columns multiplied per run (1 for decode, >1 prefill).
0x38      NUM_COLS        rw      0x00000000   activation columns per matmul
#
# Fabric clock of the bitstream, in Hz. The host reads this to convert cycle
# counters to time. The mc top exposes this register from a Verilog parameter
# populated by the Vivado build from the propagated clk_wiz output frequency.
# A zero value means the bitstream did not self-describe its clock.
0x3C      CLK_HZ          ro      0x00000000   fabric clock (Hz); set by bitstream build
0x40      WEIGHT_PORTS    ro      0x00000004   synchronized AXIS weight ports
0x44      WEIGHT_FMT      rw      0x00000001   1 = binary w1a8, 2 = ternary w158a8
0x48      NUM_ROWS        rw      0x00000000   logical output rows; 0 preserves full rowblocks
0x4C      ACT_MODE        rw      0x00000000   0 = packed Q8 load, 1 = reuse resident Q8, 2 = raw F32 load, 3 = scratch SwiGLU load
0x50      ACT_EPOCH       rw      0x00000000   caller-owned activation epoch for load/reuse matching
0x54      ACT_STATE       ro      0x00000000   bit0 = resident valid, bit1 = last-run activation error
0x58      LOADED_EPOCH    ro      0x00000000   epoch of resident Q8 activation
0x5C      LOADED_Q1_BLOCKS ro     0x00000000   K/128 of resident Q8 activation
0x60      LOADED_COLS     ro      0x00000000   columns of resident Q8 activation
0x64      QUANT_STATUS    ro      0x00000000   ingress status: q8 bits [3:0], SwiGLU nonfinite/overflow bits [5:4]
0x68      SCRATCH_MODE    rw      0x00000000   0 = legacy DDR, 1 = atomic DDR+scratch tee, 2 = scratch drain, 3 = scratch only
0x6C      SCRATCH_ROLE    rw      0x00000000   0 = R, 1 = X0/gate, 2 = X1/up, 3 = X2
0x70      SCRATCH_ROWS    rw      0x00000000   logical rows; v16 tee requires NUM_ROWS equality and 16-row alignment; v17 section uses FFN rows while MODEL_ROWS is independent
0x74      SCRATCH_TOKENS  rw      0x00000000   token/column count 1..4; v16 tee requires NUM_COLS equality; v17 captures it with MODEL_ROWS on SECTION_BEGIN
0x78      SCRATCH_CTRL    wo      0x00000000   command strobes: bit0 drain; bit1 global abort (wins); bit2 SECTION_BEGIN; bit3 RESIDENT_R qualifier only with bit2 (alone no-op)
0x7C      SCRATCH_STATUS  ro      0x00000000   v16 bits unchanged; v17 clean SECTION_DONE bit12 seals R_VALID bit5 only after final R write and output acceptance
0x80      SCRATCH_ERROR   ro      0x00000000   v14 [4:0], v16 section/SwiGLU-Q8 [6:5], v17 RMSNorm bit7 and residual-add bit8 category latches
0x84      MODEL_ROWS      rw      0x00000000   section RMSNorm/residual rows, independent of NUM_ROWS/SCRATCH_ROWS; legal values are powers of two in 128..4096
0x88      NORM_EPS        rw      0x00000000   binary32 RMSNorm epsilon; SECTION_BEGIN accepts only sign=0 and exponent 1..254, then captures the exact bits
0x8C      NORM_CTRL       wo      0x00000000   bit0 LOAD_GAMMA strobe; accepted only at NORM_STATUS.IDLE, captures MODEL_ROWS, invalidates old gamma, and consumes exactly MODEL_ROWS/2 full 64-bit activation-AXIS beats with TLAST on the final beat
0x90      NORM_STATUS     ro      0x00000400   gamma busy/done/error/valid [3:0], norm busy/done/error [6:4], residual busy/done/error [9:7], restart-safe IDLE bit10, [31:11] read zero
0x94      NORM_ERROR      ro      0x00000000   scalar-pipeline raw status [22:0], gamma raw status [26:23], controller/protocol bit27, [31:28] read zero; Q8 detail remains in QUANT_STATUS
0x98      RESIDUAL_ERROR  ro      0x00000000   exact section_residual_add raw status [6:0], [31:7] read zero
#
# (v8 had a writable EMIN window-floor register at 0x44. v9 bakes the window floor in as a
# constant of the f16 format — decode_top.EMIN_FLOOR — so there is no EMIN register and no
# per-model calibration; the 104-bit accumulator covers the full f16 range.)
#
# V17 command/lifecycle contract:
# - LOAD_GAMMA is accepted only when NORM_STATUS.IDLE=1. Acceptance clears the
#   gamma done/error latches and gamma raw error, deasserts GAMMA_VALID, captures
#   MODEL_ROWS, then opens the activation AXIS. Invalid shape retires immediately
#   with gamma done+error and consumes no AXIS beat. Only a complete, finite,
#   correctly framed transfer reseals GAMMA_VALID and sets gamma done without error.
# - SECTION_BEGIN is accepted atomically only from restart-safe idle with legal
#   MODEL_ROWS, SCRATCH_ROWS/TOKENS and NORM_EPS, and sealed matching gamma.
#   Acceptance clears norm/residual done+error and their raw error registers and
#   makes R tentative. RESIDENT_R also requires a previously sealed R whose row
#   and token metadata match MODEL_ROWS/SCRATCH_TOKENS; that sealed snapshot remains
#   privately readable by RMSNorm. Without RESIDENT_R, the activation AXIS supplies
#   exactly MODEL_ROWS*SCRATCH_TOKENS/2 full 64-bit residual beats with TLAST only
#   on the final beat. ACT_EPOCH is not consulted by either mode and retains its
#   v13 Q8 activation-reuse meaning.
# - Busy bits are live while an accepted valid operation owns resources, including
#   retained-response cleanup; an accepted invalid gamma shape may retire directly
#   to done+error without busy. An error bit may latch as soon as a fault is
#   diagnosed; its done bit latches only after the leaf is quiescent. IDLE means
#   global shared-resource quiescence: no legacy/raw activation-AXIS transaction,
#   GEMM or Q8-ingress run is active; every scratch read/write/drain owner is idle;
#   no retained scratch response is present; gamma/norm/residual are inactive; and
#   no section or abort cleanup is active. LOAD_GAMMA and SECTION_BEGIN acceptance
#   both require this complete condition. IDLE may coexist with a sealed
#   GAMMA_VALID and/or R_VALID.
# - Norm done seals only the weighted-RMSNorm/Q8 producer, not the section. Residual
#   done seals only after its last exact result is written to R and accepted on the
#   output. Clean SECTION_DONE is the architectural section seal. Gamma done/error
#   clear on the next accepted LOAD_GAMMA; norm/residual done/error clear on the next
#   accepted SECTION_BEGIN. Their raw detail clears at the same acceptance point and
#   otherwise stays latched with its lifecycle bit.
# - Any accepted section that terminates with an error, including a late residual
#   or controller fault after norm completion, invalidates GAMMA_VALID as well as
#   tentative R. A later section cannot be accepted until gamma is loaded and
#   cleanly resealed again. A rejected pre-start command does not consume that seal.
# - Global abort has priority over every simultaneous command. It accepts at any
#   time, closes ingress, drains retained responses before IDLE can reassert, clears
#   all three lifecycle done/error and raw-detail latches, invalidates gamma and any
#   active/tentative R, and never creates a clean section seal. SCRATCH_ERROR.abort
#   records cancellation of active work. A rejected command opens no stream and
#   leaves prior seals unchanged except for the documented error/category latch.
