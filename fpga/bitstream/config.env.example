# Copy to config.env and edit. Sourced by build.sh and deploy.sh.

# Windows Vivado VM (build.sh syncs RTL+TCL here over ssh and runs build.bat).
VM=10.211.55.3
VM_DIR=penzai-combined-v1

# KR260 board (deploy.sh loads the bitstream here).
BOARD=ubuntu@kria
APP=penzai-combined-v1
BOARD_TMP=/tmp/penzai-combined

# Default bitstream variant: w512-p4-f<MHz>. f is the single fabric clock that drives
# both kernels, all control, and all data movement. The current routed default is f300.
VARIANT=w512-p4-f300
