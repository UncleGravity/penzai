# Copy to config.env and edit. Sourced by build.sh and deploy.sh.

# Windows Vivado VM (build.sh syncs RTL+TCL here over ssh and runs build.bat).
VM=10.211.55.3
VM_DIR=penzai
VM_OOC=penzai-ooc

# KR260 board (deploy.sh loads the bitstream here).
BOARD=ubuntu@kria
APP=penzai
BOARD_TMP=/tmp/penzai

# Default bitstream variant: f<MHz>. f is the single fabric clock that drives
# the token engine, all control, and all data movement. The routed default is f225.
VARIANT=f225

# Set to 1 for development builds that reuse the last timing-clean routed checkpoint.
# Leave at 0 for an independent full build. --incremental overrides this to 1.
INCREMENTAL=0
