[script]
prove: read -formal -sv -DFORMAL -DFORMAL_QUERY_BLOCKED datapath_stubs.v flash_kernel.v harness.sv
completion: read -formal -sv -DFORMAL -DFORMAL_QUERY_BLOCKED -DFORMAL_COMPLETION_ONLY -DFORMAL_BOUNDED_LIVENESS datapath_stubs.v flash_kernel.v harness.sv
bmc: read -formal -sv -DFORMAL -DFORMAL_QUERY_BLOCKED datapath_stubs.v flash_kernel.v harness.sv
liveness: read -formal -sv -DFORMAL -DFORMAL_QUERY_BLOCKED -DFORMAL_BOUNDED_LIVENESS -DFORMAL_LIVENESS_ONLY datapath_stubs.v flash_kernel.v harness.sv
cover: read -formal -sv -DFORMAL -DFORMAL_QUERY_BLOCKED -DFORMAL_DIRECTED_COVER datapath_stubs.v flash_kernel.v harness.sv
slots_prove: read -formal -sv -DFORMAL -DFORMAL_ADAPTIVE_SLOTS datapath_stubs.v flash_kernel.v slot_map_harness.sv
slots_bmc: read -formal -sv -DFORMAL -DFORMAL_ADAPTIVE_SLOTS datapath_stubs.v flash_kernel.v slot_map_harness.sv
slots_cover: read -formal -sv -DFORMAL -DFORMAL_ADAPTIVE_SLOTS datapath_stubs.v flash_kernel.v slot_map_harness.sv
pipeline_prove: read -formal -sv -DFORMAL -DFORMAL_PIPELINE_VALUES datapath_stubs.v flash_kernel.v slot_map_harness.sv
prove: prep -top flash_kernel_harness
completion: prep -top flash_kernel_harness
bmc: prep -top flash_kernel_harness
liveness: prep -top flash_kernel_harness
cover: prep -top flash_kernel_harness
slots_prove: prep -top flash_slot_map_harness
slots_bmc: prep -top flash_slot_map_harness
slots_cover: prep -top flash_slot_map_harness
pipeline_prove: prep -top flash_slot_map_harness

