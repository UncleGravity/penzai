# Copy to config.env and edit. Sourced by build.sh and deploy.sh.

# Windows Vivado VM (build.sh syncs RTL+TCL here over ssh and runs build.bat).
VM=10.211.55.3
VM_DIR=penzai-flash-v1

# KR260 board (deploy.sh loads the bitstream here).
BOARD=ubuntu@kria
APP=penzai-flash-v1
BOARD_TMP=/tmp/penzai-flash

# Default bitstream variant (f<MHz>). The v1 sequential kernel is not timing-tight;
# 100 MHz is the safe starting target.
VARIANT=f100
