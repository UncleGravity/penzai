# Copy to config.env and edit. Sourced by build.sh and deploy.sh.

# Windows Vivado VM (build.sh syncs RTL+TCL here over ssh and runs build.bat).
VM=10.211.55.3
VM_DIR=penzai-combined-v1

# KR260 board (deploy.sh loads the bitstream here).
BOARD=ubuntu@kria
APP=penzai-combined-v1
BOARD_TMP=/tmp/penzai-combined

# Default bitstream variant: w512-p4-f<MHz>-wc<MHz>. f = the shared kernel clock that
# drives BOTH the matmul and flash kernels (flash is validated at 200 MHz; matmul closes
# higher). wc = the matmul weight-feed clock. Start at f200 (safe for flash), then try
# higher f once it closes timing.
VARIANT=w512-p4-f200-wc300
