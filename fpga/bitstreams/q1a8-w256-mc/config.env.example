# Copy to config.env and edit. Sourced by build.sh and deploy.sh.

# Windows Vivado VM (build.sh syncs RTL+TCL here over ssh and runs build.bat).
VM=10.211.55.3
VM_DIR=penzai-q1a8-mc-w256

# KR260 board (deploy.sh loads the bitstream here).
BOARD=ubuntu@kria
APP=penzai-q1a8-mc
BOARD_TMP=/tmp/penzai-q1a8

# Default bitstream variant (w256-f<MHz>). 100 MHz is the timing-safe target.
VARIANT=w256-f125
