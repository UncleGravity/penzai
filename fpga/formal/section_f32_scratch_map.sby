[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 48
prove: aigsmt boolector
bmc: mode bmc
bmc: depth 32
cover: mode cover
cover: depth 40

[engines]
prove: abc pdr
bmc: smtbmc boolector
cover: smtbmc boolector

[script]
prove: read -formal -D MAP_PROVE section_f32_scratch.v section_f32_scratch_map_formal.sv
bmc: read -formal section_f32_scratch.v section_f32_scratch_map_formal.sv
cover: read -formal section_f32_scratch.v section_f32_scratch_map_formal.sv
prep -top section_f32_scratch_map_formal -flatten

[files]
fpga/rtl/section_f32_scratch.v
fpga/formal/section_f32_scratch_map_formal.sv
