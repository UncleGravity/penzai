[tasks]
startup
clean
reduce_fault
source_fault
abort_reduce
abort_source
abort_output
cfg_reject
orphan_fault
cover_startup
cover_clean
cover_reduce_fault
cover_source_fault
cover_abort_reduce
cover_abort_source
cover_abort_output
cover_cfg_reject
cover_orphan_fault

[options]
startup: mode bmc
startup: depth 120
clean: mode bmc
clean: depth 760
reduce_fault: mode bmc
reduce_fault: depth 900
source_fault: mode bmc
source_fault: depth 950
abort_reduce: mode bmc
abort_reduce: depth 900
abort_source: mode bmc
abort_source: depth 950
abort_output: mode bmc
abort_output: depth 1100
cfg_reject: mode bmc
cfg_reject: depth 850
orphan_fault: mode bmc
orphan_fault: depth 900
cover_startup: mode cover
cover_startup: depth 120
cover_clean: mode cover
cover_clean: depth 760
cover_reduce_fault: mode cover
cover_reduce_fault: depth 900
cover_source_fault: mode cover
cover_source_fault: depth 950
cover_abort_reduce: mode cover
cover_abort_reduce: depth 900
cover_abort_source: mode cover
cover_abort_source: depth 950
cover_abort_output: mode cover
cover_abort_output: depth 1100
cover_cfg_reject: mode cover
cover_cfg_reject: depth 850
cover_orphan_fault: mode cover
cover_orphan_fault: depth 900

[engines]
smtbmc boolector

[script]
startup: read -formal -D FORMAL -D FORMAL_SC_STARTUP section_rmsnorm_reduce_stubs.v section_rmsnorm_q8_pipeline_stubs.v section_rmsnorm_reduce.v section_rmsnorm_weighted_source.v q8_ingress.v section_rmsnorm_q8_source.v section_rmsnorm_q8_pipeline.v section_rmsnorm_q8_pipeline_formal.sv
clean: read -formal -D FORMAL -D FORMAL_SC_CLEAN section_rmsnorm_reduce_stubs.v section_rmsnorm_q8_pipeline_stubs.v section_rmsnorm_reduce.v section_rmsnorm_weighted_source.v q8_ingress.v section_rmsnorm_q8_source.v section_rmsnorm_q8_pipeline.v section_rmsnorm_q8_pipeline_formal.sv
reduce_fault: read -formal -D FORMAL -D FORMAL_SC_REDUCE_FAULT section_rmsnorm_reduce_stubs.v section_rmsnorm_q8_pipeline_stubs.v section_rmsnorm_reduce.v section_rmsnorm_weighted_source.v q8_ingress.v section_rmsnorm_q8_source.v section_rmsnorm_q8_pipeline.v section_rmsnorm_q8_pipeline_formal.sv
