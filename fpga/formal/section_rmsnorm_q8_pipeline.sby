abort_source: read -formal -D FORMAL -D FORMAL_SC_ABORT_SOURCE section_rmsnorm_reduce_stubs.v section_rmsnorm_q8_pipeline_stubs.v section_rmsnorm_reduce.v section_rmsnorm_weighted_source.v q8_ingress.v section_rmsnorm_q8_source.v section_rmsnorm_q8_pipeline.v section_rmsnorm_q8_pipeline_formal.sv
abort_output: read -formal -D FORMAL -D FORMAL_SC_ABORT_OUTPUT section_rmsnorm_reduce_stubs.v section_rmsnorm_q8_pipeline_stubs.v section_rmsnorm_reduce.v section_rmsnorm_weighted_source.v q8_ingress.v section_rmsnorm_q8_source.v section_rmsnorm_q8_pipeline.v section_rmsnorm_q8_pipeline_formal.sv
