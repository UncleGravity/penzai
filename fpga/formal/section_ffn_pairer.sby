[tasks]
bmc
data
cover

[options]
bmc: mode bmc
bmc: depth 40
data: mode bmc
data: depth 256
cover: mode cover
cover: depth 80

[engines]
bmc: smtbmc boolector
data: smtbmc boolector
cover: smtbmc boolector

[script]
bmc: read -formal -D FORMAL section_ffn_pairer.v section_ffn_pairer_formal.sv
data: read -formal -D FORMAL -D FORMAL_DATA section_ffn_pairer.v section_ffn_pairer_formal.sv
cover: read -formal -D FORMAL -D FORMAL_COVER section_ffn_pairer.v section_ffn_pairer_formal.sv
prep -top section_ffn_pairer_formal -flatten

[files]
fpga/rtl/section_ffn_pairer.v
fpga/formal/section_ffn_pairer_formal.sv
