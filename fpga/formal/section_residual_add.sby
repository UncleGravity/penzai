[tasks]
stalls
clean
read_fault
write_fault
frame_fault
arith_fault
abort_read
orphan
cover_clean
cover_read_fault
cover_write_fault
cover_frame_fault
cover_arith_fault
cover_abort_read
cover_orphan

[options]
stalls: mode bmc
stalls: depth 48
clean: mode bmc
clean: depth 140
read_fault: mode bmc
read_fault: depth 140
write_fault: mode bmc
write_fault: depth 140
frame_fault: mode bmc
frame_fault: depth 140
arith_fault: mode bmc
arith_fault: depth 140
abort_read: mode bmc
abort_read: depth 140
orphan: mode bmc
orphan: depth 140
cover_clean: mode cover
cover_clean: depth 180
cover_read_fault: mode cover
cover_read_fault: depth 180
cover_write_fault: mode cover
cover_write_fault: depth 180
cover_frame_fault: mode cover
cover_frame_fault: depth 180
cover_arith_fault: mode cover
cover_arith_fault: depth 180
cover_abort_read: mode cover
cover_abort_read: depth 180
cover_orphan: mode cover
cover_orphan: depth 180

[engines]
stalls: abc bmc3
clean: abc bmc3
read_fault: smtbmc boolector
write_fault: smtbmc boolector
frame_fault: smtbmc boolector
arith_fault: smtbmc boolector
abort_read: smtbmc boolector
orphan: smtbmc boolector
cover_clean: smtbmc boolector
cover_read_fault: smtbmc boolector
cover_write_fault: smtbmc boolector
cover_frame_fault: smtbmc boolector
cover_arith_fault: smtbmc boolector
cover_abort_read: smtbmc boolector
cover_orphan: smtbmc boolector

[script]
stalls: read -formal -D FORMAL section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
clean: read -formal -D FORMAL -D FORMAL_PROGRESS section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
read_fault: read -formal -D FORMAL -D FORMAL_PROGRESS -D FORMAL_SC_READ_FAULT section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
write_fault: read -formal -D FORMAL -D FORMAL_PROGRESS -D FORMAL_SC_WRITE_FAULT section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
frame_fault: read -formal -D FORMAL -D FORMAL_PROGRESS -D FORMAL_SC_FRAME_FAULT section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
arith_fault: read -formal -D FORMAL -D FORMAL_PROGRESS -D FORMAL_SC_ARITH_FAULT section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
abort_read: read -formal -D FORMAL -D FORMAL_PROGRESS -D FORMAL_SC_ABORT_READ section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
orphan: read -formal -D FORMAL -D FORMAL_PROGRESS -D FORMAL_SC_ORPHAN section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
cover_clean: read -formal -D FORMAL -D FORMAL_COVER section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
cover_read_fault: read -formal -D FORMAL -D FORMAL_COVER -D FORMAL_SC_READ_FAULT section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
cover_write_fault: read -formal -D FORMAL -D FORMAL_COVER -D FORMAL_SC_WRITE_FAULT section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
cover_frame_fault: read -formal -D FORMAL -D FORMAL_COVER -D FORMAL_SC_FRAME_FAULT section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
cover_arith_fault: read -formal -D FORMAL -D FORMAL_COVER -D FORMAL_SC_ARITH_FAULT section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
cover_abort_read: read -formal -D FORMAL -D FORMAL_COVER -D FORMAL_SC_ABORT_READ section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
cover_orphan: read -formal -D FORMAL -D FORMAL_COVER -D FORMAL_SC_ORPHAN section_residual_add_stubs.v section_residual_add.v section_residual_add_formal.sv
prep -top section_residual_add_formal -flatten

[files]
fpga/formal/section_residual_add_stubs.v
fpga/rtl/section_residual_add.v
fpga/formal/section_residual_add_formal.sv
