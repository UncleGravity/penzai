[tasks]
clean_bmc
abort_bmc
clean_cover
abort_cover
inactive_norm_bmc
inactive_norm_cover
inactive_residual_bmc
inactive_residual_cover
q8_cfg_bmc
q8_cfg_cover

[options]
clean_bmc: mode bmc
clean_bmc: depth 920
abort_bmc: mode bmc
abort_bmc: depth 275
clean_cover: mode cover
clean_cover: depth 910
clean_cover: skip 885
abort_cover: mode cover
abort_cover: depth 275
abort_cover: skip 250
inactive_norm_bmc: mode bmc
inactive_norm_bmc: depth 275
inactive_norm_cover: mode cover
inactive_norm_cover: depth 275
inactive_norm_cover: skip 200
inactive_residual_bmc: mode bmc
inactive_residual_bmc: depth 770
inactive_residual_cover: mode cover
inactive_residual_cover: depth 800
inactive_residual_cover: skip 740
q8_cfg_bmc: mode bmc
q8_cfg_bmc: depth 1100
q8_cfg_cover: mode cover
q8_cfg_cover: depth 810
q8_cfg_cover: skip 760

[engines]
smtbmc boolector

[script]
clean_bmc: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_p3d_formal.sv
abort_bmc: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION -D FORMAL_P3D_ABORT decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_p3d_formal.sv
clean_cover: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION -D FORMAL_P3D_COVER decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_p3d_formal.sv
abort_cover: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION -D FORMAL_P3D_ABORT -D FORMAL_P3D_COVER decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_p3d_formal.sv
inactive_norm_bmc: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION -D FORMAL_P3D_COVER -D FORMAL_P3D_INACTIVE_NORM decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_p3d_formal.sv
inactive_norm_cover: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION -D FORMAL_P3D_COVER -D FORMAL_P3D_INACTIVE_NORM decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_p3d_formal.sv
inactive_residual_bmc: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION -D FORMAL_P3D_COVER -D FORMAL_P3D_INACTIVE_RESIDUAL decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_p3d_formal.sv
inactive_residual_cover: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION -D FORMAL_P3D_COVER -D FORMAL_P3D_INACTIVE_RESIDUAL decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_p3d_formal.sv
q8_cfg_bmc: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION -D FORMAL_P3D_COVER -D FORMAL_P3D_Q8_CFG_COVER decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_p3d_formal.sv
q8_cfg_cover: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION -D FORMAL_P3D_COVER -D FORMAL_P3D_Q8_CFG_COVER decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_p3d_formal.sv
prep -top decode_p3d_formal -flatten

[files]
fpga/formal/decode_ffn_stubs.v
fpga/regmap/matmul_regs.vh
fpga/rtl/section_gate_packer.v
fpga/rtl/section_ffn_pairer.v
