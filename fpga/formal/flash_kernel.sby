[options]
prove: mode prove
prove: depth 120
prove: aigsmt boolector
completion: mode bmc
completion: depth 272
bmc: mode bmc
bmc: depth 40
liveness: mode bmc
liveness: depth 272
cover: mode cover
cover: depth 320
slots_prove: mode prove
slots_prove: depth 12
slots_prove: aigsmt boolector
slots_bmc: mode bmc
slots_bmc: depth 12
slots_cover: mode cover
slots_cover: depth 12
pipeline_prove: mode prove
pipeline_prove: depth 4

[engines]
prove: abc pdr
completion: abc bmc3
bmc: smtbmc boolector
liveness: abc bmc3
cover: smtbmc boolector
slots_prove: abc pdr
slots_bmc: smtbmc boolector
slots_cover: smtbmc boolector
pipeline_prove: smtbmc boolector

[script]
prove: read -formal -sv -DFORMAL -DFORMAL_QUERY_BLOCKED flash_datapath_stubs.v flash_kernel.v flash_kernel_formal.sv
completion: read -formal -sv -DFORMAL -DFORMAL_QUERY_BLOCKED -DFORMAL_COMPLETION_ONLY -DFORMAL_BOUNDED_LIVENESS flash_datapath_stubs.v flash_kernel.v flash_kernel_formal.sv
bmc: read -formal -sv -DFORMAL -DFORMAL_QUERY_BLOCKED flash_datapath_stubs.v flash_kernel.v flash_kernel_formal.sv
liveness: read -formal -sv -DFORMAL -DFORMAL_QUERY_BLOCKED -DFORMAL_BOUNDED_LIVENESS -DFORMAL_LIVENESS_ONLY flash_datapath_stubs.v flash_kernel.v flash_kernel_formal.sv
cover: read -formal -sv -DFORMAL -DFORMAL_QUERY_BLOCKED -DFORMAL_DIRECTED_COVER flash_datapath_stubs.v flash_kernel.v flash_kernel_formal.sv
slots_prove: read -formal -sv -DFORMAL -DFORMAL_ADAPTIVE_SLOTS flash_datapath_stubs.v flash_kernel.v flash_slots_formal.sv
slots_bmc: read -formal -sv -DFORMAL -DFORMAL_ADAPTIVE_SLOTS flash_datapath_stubs.v flash_kernel.v flash_slots_formal.sv
slots_cover: read -formal -sv -DFORMAL -DFORMAL_ADAPTIVE_SLOTS flash_datapath_stubs.v flash_kernel.v flash_slots_formal.sv
pipeline_prove: read -formal -sv -DFORMAL -DFORMAL_PIPELINE_VALUES flash_datapath_stubs.v flash_kernel.v flash_slots_formal.sv
prove: prep -top flash_kernel_formal
completion: prep -top flash_kernel_formal
bmc: prep -top flash_kernel_formal
liveness: prep -top flash_kernel_formal
cover: prep -top flash_kernel_formal
slots_prove: prep -top flash_slots_formal
slots_bmc: prep -top flash_slots_formal
slots_cover: prep -top flash_slots_formal
pipeline_prove: prep -top flash_slots_formal

