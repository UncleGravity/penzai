[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 120
prove: aigsmt boolector
bmc: mode bmc
bmc: depth 40
cover: mode cover
cover: depth 160

[engines]
prove: abc pdr
bmc: smtbmc boolector
cover: smtbmc boolector

[script]
prove: read -formal -sv -DFORMAL flash_datapath_stubs.v flash_kernel.v flash_kernel_formal.sv
bmc: read -formal -sv -DFORMAL flash_datapath_stubs.v flash_kernel.v flash_kernel_formal.sv
cover: read -formal -sv -DFORMAL -DFORMAL_DIRECTED_COVER flash_datapath_stubs.v flash_kernel.v flash_kernel_formal.sv
prep -top flash_kernel_formal

[files]
fpga/formal/flash_datapath_stubs.v
fpga/rtl/flash_attn/flash_kernel.v
fpga/rtl/numeric/fmt.vh
fpga/formal/flash_kernel_properties.vh
fpga/formal/flash_kernel_formal.sv
