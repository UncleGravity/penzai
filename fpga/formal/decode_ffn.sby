[tasks]
bmc
clean_cover
abort_cover

[options]
bmc: mode bmc
bmc: depth 520
clean_cover: mode cover
clean_cover: depth 400
clean_cover: skip 390
abort_cover: mode cover
abort_cover: depth 520
abort_cover: skip 508

[engines]
bmc: abc bmc3
clean_cover: smtbmc boolector
abort_cover: smtbmc boolector

[script]
bmc: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_ffn_formal.sv
clean_cover: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION -D FORMAL_COVER_CLEAN decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_ffn_formal.sv
abort_cover: read -formal -D FORMAL -D FORMAL_REDUCED_STORAGE -D FORMAL_DECODE_INTEGRATION -D FORMAL_COVER_ABORT decode_ffn_stubs.v section_gate_packer.v section_ffn_pairer.v section_q8_buffer.v decode_top.v decode_ffn_formal.sv
prep -top decode_ffn_formal -flatten

[files]
fpga/formal/decode_ffn_stubs.v
fpga/regmap/matmul_regs.vh
fpga/rtl/section_gate_packer.v
fpga/rtl/section_ffn_pairer.v
fpga/rtl/section_q8_buffer.v
fpga/rtl/decode_top.v
fpga/formal/decode_ffn_formal.sv
