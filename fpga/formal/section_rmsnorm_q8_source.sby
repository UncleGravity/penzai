cover_startup: read -formal -D FORMAL -D FORMAL_COVER -D FORMAL_SC_STARTUP section_rmsnorm_q8_source_stubs.v section_rmsnorm_weighted_source.v q8_ingress.v section_rmsnorm_q8_source.v section_rmsnorm_q8_source_formal.sv
