[script]
startup: read -formal -D FORMAL -D FORMAL_SC_STARTUP section_rmsnorm_q8_source_stubs.v section_rmsnorm_weighted_source.v q8_ingress.v section_rmsnorm_q8_source.v section_rmsnorm_q8_source_formal.sv
clean1: read -formal -D FORMAL -D FORMAL_SC_CLEAN1 section_rmsnorm_q8_source_stubs.v section_rmsnorm_weighted_source.v q8_ingress.v section_rmsnorm_q8_source.v section_rmsnorm_q8_source_formal.sv
clean2: read -formal -D FORMAL -D FORMAL_SC_CLEAN2 section_rmsnorm_q8_source_stubs.v section_rmsnorm_weighted_source.v q8_ingress.v section_rmsnorm_q8_source.v section_rmsnorm_q8_source_formal.sv
