[tasks]
bmc
faults
cover

[options]
bmc: mode bmc
bmc: depth 64
faults: mode bmc
faults: depth 112
cover: mode cover
cover: depth 160

[engines]
bmc: abc bmc3
faults: abc bmc3
cover: smtbmc boolector

[script]
bmc: read -formal -D FORMAL -D FORMAL_BMC section_rmsnorm_reduce_stubs.v section_rmsnorm_reduce.v section_rmsnorm_reduce_formal.sv
faults: read -formal -D FORMAL -D FORMAL_FAULTS section_rmsnorm_reduce_stubs.v section_rmsnorm_reduce.v section_rmsnorm_reduce_formal.sv
cover: read -formal -D FORMAL -D FORMAL_COVER section_rmsnorm_reduce_stubs.v section_rmsnorm_reduce.v section_rmsnorm_reduce_formal.sv
prep -top section_rmsnorm_reduce_formal -flatten

[files]
fpga/formal/section_rmsnorm_reduce_stubs.v
fpga/rtl/section_rmsnorm_reduce.v
fpga/formal/section_rmsnorm_reduce_formal.sv
