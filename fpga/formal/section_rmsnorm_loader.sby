[tasks]
bmc
faults
cover

[options]
bmc: mode bmc
bmc: depth 40
faults: mode bmc
faults: depth 24
cover: mode cover
cover: depth 40

[engines]
bmc: abc bmc3
faults: abc bmc3
cover: smtbmc boolector

[script]
bmc: read -formal -D FORMAL -D FORMAL_BMC section_rmsnorm_loader.v section_rmsnorm_loader_formal.sv
faults: read -formal -D FORMAL -D FORMAL_FAULTS section_rmsnorm_loader.v section_rmsnorm_loader_formal.sv
cover: read -formal -D FORMAL -D FORMAL_COVER section_rmsnorm_loader.v section_rmsnorm_loader_formal.sv
prep -top section_rmsnorm_loader_formal -flatten

[files]
fpga/rtl/section_rmsnorm_loader.v
fpga/formal/section_rmsnorm_loader_formal.sv
