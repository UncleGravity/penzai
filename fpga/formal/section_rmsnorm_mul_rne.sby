[options]
control: mode prove
control: depth 24
product: mode bmc
product: depth 10
data: mode bmc
data: depth 10
cover: mode cover
cover: depth 48

[engines]
control: abc pdr
product: abc bmc3
data: smtbmc boolector
cover: smtbmc boolector

[script]
control: read -formal -D FORMAL -D FORMAL_CONTROL section_rmsnorm_mul_rne.v section_rmsnorm_mul_rne_formal.sv
product: read -formal -D FORMAL -D FORMAL_PRODUCT section_rmsnorm_mul_rne.v section_rmsnorm_mul_rne_formal.sv
data: read -formal -D FORMAL -D FORMAL_DATA section_rmsnorm_mul_rne.v section_rmsnorm_mul_rne_formal.sv
cover: read -formal -D FORMAL -D FORMAL_COVER section_rmsnorm_mul_rne.v section_rmsnorm_mul_rne_formal.sv
prep -top section_rmsnorm_mul_rne_formal -flatten

