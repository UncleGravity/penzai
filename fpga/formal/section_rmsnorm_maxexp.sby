[tasks]
bmc
stalls
faults
cover

[options]
bmc: mode bmc
bmc: depth 24
stalls: mode bmc
stalls: depth 32
faults: mode bmc
faults: depth 32
cover: mode cover
cover: depth 64

[engines]
bmc: smtbmc boolector
stalls: smtbmc boolector
faults: smtbmc boolector
cover: smtbmc boolector

[script]
bmc: read -formal -D FORMAL -D FORMAL_BMC section_rmsnorm_maxexp.v section_rmsnorm_maxexp_formal.sv
stalls: read -formal -D FORMAL -D FORMAL_STALLS section_rmsnorm_maxexp.v section_rmsnorm_maxexp_formal.sv
faults: read -formal -D FORMAL -D FORMAL_FAULTS section_rmsnorm_maxexp.v section_rmsnorm_maxexp_formal.sv
cover: read -formal -D FORMAL -D FORMAL_COVER section_rmsnorm_maxexp.v section_rmsnorm_maxexp_formal.sv
prep -top section_rmsnorm_maxexp_formal -flatten

[files]
fpga/rtl/section_rmsnorm_maxexp.v
fpga/formal/section_rmsnorm_maxexp_formal.sv
