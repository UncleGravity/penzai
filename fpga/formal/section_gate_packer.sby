[tasks]
bmc
data
data_cover
cover

[options]
bmc: mode bmc
bmc: depth 48
data: mode bmc
data: depth 144
data_cover: mode cover
data_cover: depth 144
cover: mode cover
cover: depth 96

[engines]
bmc: smtbmc boolector
data: smtbmc boolector
data_cover: smtbmc boolector
cover: smtbmc boolector

[script]
bmc: read -formal -D FORMAL section_gate_packer.v section_gate_packer_formal.sv
data: read -formal -D FORMAL -D FORMAL_DATA section_gate_packer.v section_gate_packer_formal.sv
data_cover: read -formal -D FORMAL -D FORMAL_DATA -D FORMAL_DATA_COVER section_gate_packer.v section_gate_packer_formal.sv
cover: read -formal -D FORMAL -D FORMAL_COVER section_gate_packer.v section_gate_packer_formal.sv
prep -top section_gate_packer_formal -flatten

[files]
fpga/rtl/section_gate_packer.v
