[tasks]
bmc
data
faults
cover

[options]
bmc: mode bmc
bmc: depth 80
data: mode bmc
data: depth 64
faults: mode bmc
faults: depth 64
cover: mode cover
cover: depth 128

[engines]
bmc: abc bmc3
data: smtbmc boolector
faults: smtbmc boolector
cover: smtbmc boolector

[script]
bmc: read -formal -D FORMAL -D FORMAL_BMC section_rmsnorm_sumsq.v section_rmsnorm_sumsq_formal.sv
data: read -formal -D FORMAL -D FORMAL_DATA section_rmsnorm_sumsq.v section_rmsnorm_sumsq_formal.sv
faults: read -formal -D FORMAL -D FORMAL_FAULTS section_rmsnorm_sumsq.v section_rmsnorm_sumsq_formal.sv
cover: read -formal -D FORMAL -D FORMAL_COVER section_rmsnorm_sumsq.v section_rmsnorm_sumsq_formal.sv
prep -top section_rmsnorm_sumsq_formal -flatten

[files]
fpga/rtl/section_rmsnorm_sumsq.v
fpga/formal/section_rmsnorm_sumsq_formal.sv
