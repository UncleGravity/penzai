+static bool penzai_discover_inference_v1(llama_model * model) {
+    const penzai_inference_v1 * selected = nullptr;
+    ggml_backend_dev_t selected_device = nullptr;
+
+    for (const auto & device : model->devices) {
+        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(device.dev);
+        if (reg == nullptr) {
+            continue;
+        }
+
+        void * proc = ggml_backend_reg_get_proc_address(reg, PENZAI_INFERENCE_V1_SYMBOL);
+        if (proc == nullptr) {
+            continue;
+        }
+        if (selected != nullptr) {
+            LLAMA_LOG_ERROR("%s: more than one selected device exposes %s\n", __func__, PENZAI_INFERENCE_V1_SYMBOL);
+            return false;
+        }
+
+        const auto query = reinterpret_cast<penzai_inference_query_v1_fn>(proc);
+        const penzai_inference_v1 * api = query();
+        const size_t required_size = offsetof(penzai_inference_v1, status_message) + sizeof(api->status_message);
+        const uint64_t required_features = PENZAI_INFERENCE_FEATURE_GREEDY_ONLY_V1 |
+            PENZAI_INFERENCE_FEATURE_SINGLE_SEQUENCE_V1 |
+            PENZAI_INFERENCE_FEATURE_WINNER_LOGIT_V1;
+        if (api == nullptr || api->abi_version != PENZAI_INFERENCE_V1_ABI_VERSION ||
+            api->struct_size < required_size ||
+            (api->features & required_features) != required_features ||
+            api->load_model == nullptr || api->unload_model == nullptr ||
+            api->open_session == nullptr || api->close_session == nullptr ||
+            api->reset_session == nullptr || api->execute == nullptr) {
+            LLAMA_LOG_ERROR("%s: device %s exposes an incompatible %s contract\n",
+                    __func__, ggml_backend_dev_name(device.dev), PENZAI_INFERENCE_V1_SYMBOL);
+            return false;
+        }
+
+        selected = api;
+        selected_device = device.dev;
+    }
+
+    if (selected == nullptr) {
+        return true;
+    }
+    if (model->devices.size() != 1) {
+        LLAMA_LOG_ERROR("%s: %s requires exactly one selected accelerator device\n",
+                __func__, PENZAI_INFERENCE_V1_SYMBOL);
+        return false;
+    }
+
+    model->inference_v1 = selected;
+    model->inference_device = selected_device;
+    LLAMA_LOG_INFO("%s: using whole-token executor %s from device %s\n",
+            __func__, PENZAI_INFERENCE_V1_SYMBOL, ggml_backend_dev_name(selected_device));
+    return true;
+}
