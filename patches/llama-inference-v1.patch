+static const char * penzai_inference_status_detail(const penzai_inference_v1 * api, int32_t status) {
+    if (api->status_message == nullptr) {
+        return "no provider detail";
+    }
+    const char * detail = api->status_message(status);
+    return detail != nullptr ? detail : "no provider detail";
+}
+
+class penzai_inference_no_update final : public llama_memory_context_i {
+public:
+    bool next() override { return false; }
+    bool apply() override { return true; }
+    const llama_ubatch & get_ubatch() const override { return ubatch; }
+    llama_memory_status get_status() const override { return LLAMA_MEMORY_STATUS_NO_UPDATE; }
+
+private:
+    llama_ubatch ubatch = {};
+};
+
+class penzai_inference_memory final : public llama_memory_i {
+public:
+    penzai_inference_memory(
+            const penzai_inference_v1 * api,
+            void * session,
+            uint32_t capacity,
+            uint32_t max_tile) :
+        api(api), session(session), capacity_tokens(capacity), max_tile_tokens(max_tile) {
+    }
+
+    ~penzai_inference_memory() override {
+        if (session != nullptr) {
+            api->close_session(session);
+        }
+    }
+
+    llama_memory_context_ptr init_batch(llama_batch_allocr &, uint32_t, bool) override { return nullptr; }
+    llama_memory_context_ptr init_full() override { return nullptr; }
+    llama_memory_context_ptr init_update(llama_context *, bool) override {
+        return std::make_unique<penzai_inference_no_update>();
+    }
+
+    bool get_can_shift() const override { return false; }
+
+    void clear(bool) override {
+        if (!reset()) {
+            LLAMA_LOG_ERROR("%s: penzai.inference.v1 session reset failed\n", __func__);
+        }
+    }
+
+    bool seq_rm(llama_seq_id seq_id, llama_pos p0, llama_pos p1) override {
+        if (seq_id != 0 && seq_id != -1) {
+            return false;
+        }
+        if (p1 < 0 && p0 == static_cast<llama_pos>(position_tokens)) {
+            return true;
+        }
+        if (p1 < 0 && p0 <= 0) {
+            return reset();
+        }
+        return false;
+    }
+
+    void seq_cp(llama_seq_id, llama_seq_id, llama_pos, llama_pos) override {
+        healthy = false;
+        LLAMA_LOG_ERROR("%s: sequence copies are unsupported by penzai.inference.v1\n", __func__);
+    }
+    void seq_keep(llama_seq_id seq_id) override {
+        if (seq_id != 0) {
+            healthy = false;
+        }
+    }
+    void seq_add(llama_seq_id, llama_pos, llama_pos, llama_pos) override {
+        healthy = false;
+        LLAMA_LOG_ERROR("%s: context shifting is unsupported by penzai.inference.v1\n", __func__);
+    }
+    void seq_div(llama_seq_id, llama_pos, llama_pos, int) override {
+        healthy = false;
+        LLAMA_LOG_ERROR("%s: sequence division is unsupported by penzai.inference.v1\n", __func__);
+    }
+
+    llama_pos seq_pos_min(llama_seq_id seq_id) const override {
+        return seq_id == 0 && position_tokens != 0 ? 0 : -1;
+    }
+    llama_pos seq_pos_max(llama_seq_id seq_id) const override {
+        return seq_id == 0 && position_tokens != 0 ? static_cast<llama_pos>(position_tokens - 1) : -1;
+    }
+
+    std::map<ggml_backend_buffer_type_t, size_t> memory_breakdown() const override { return {}; }
+
+    [[noreturn]] void state_write(llama_io_write_i &, llama_seq_id, llama_state_seq_flags) const override {
+        throw std::runtime_error("state export is unsupported by penzai.inference.v1");
+    }
+    [[noreturn]] void state_read(llama_io_read_i &, llama_seq_id, llama_state_seq_flags) override {
+        throw std::runtime_error("state import is unsupported by penzai.inference.v1");
+    }
+
+    bool reset() {
+        const int32_t status = api->reset_session(session);
+        healthy = status == PENZAI_INFERENCE_STATUS_OK_V1;
+        if (healthy) {
+            position_tokens = 0;
+        }
+        return healthy;
+    }
+
+    void fail_and_reset() {
+        const int32_t status = api->reset_session(session);
+        position_tokens = 0;
+        healthy = false;
+        if (status != PENZAI_INFERENCE_STATUS_OK_V1) {
+            LLAMA_LOG_ERROR("%s: penzai.inference.v1 recovery reset failed\n", __func__);
+        }
+    }
+
+    const penzai_inference_v1 * api;
+    void * session;
+    uint32_t capacity_tokens;
+    uint32_t max_tile_tokens;
+    uint32_t position_tokens = 0;
+    bool healthy = true;
+};
