+static bool penzai_inference_same_source(
+        const llama_model_loader & ml,
+        const ggml_tensor * first,
+        const ggml_tensor * second) {
+    if (first == nullptr || second == nullptr) {
+        return false;
+    }
+    const auto & a = ml.require_weight(ggml_get_name(first));
+    const auto & b = ml.require_weight(ggml_get_name(second));
+    return a.idx == b.idx && a.offs == b.offs && ggml_nbytes(first) == ggml_nbytes(second);
+}
