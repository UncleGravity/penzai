+
+static penzai_inference_tensor_source_v1 penzai_inference_tensor_source(
+        const llama_model_loader & ml,
+        const ggml_tensor * tensor) {
+    if (tensor == nullptr) {
+        return {};
+    }
+
+    const auto & weight = ml.require_weight(ggml_get_name(tensor));
+    const auto & mapping = ml.mappings.at(weight.idx);
+
+    penzai_inference_tensor_source_v1 result = {};
+    result.struct_size = sizeof(result);
+    result.format = penzai_inference_weight_format(tensor->type);
+    result.rank = static_cast<uint32_t>(ggml_n_dims(tensor));
+    for (uint32_t i = 0; i < 4; ++i) {
+        result.dimensions[i] = static_cast<uint64_t>(tensor->ne[i]);
+    }
+    result.data = static_cast<const uint8_t *>(mapping->addr()) + weight.offs;
+    result.data_size = static_cast<uint64_t>(ggml_nbytes(tensor));
+    result.name = ggml_get_name(tensor);
+    result.name_size = static_cast<uint32_t>(strlen(result.name));
+    return result;
+}
